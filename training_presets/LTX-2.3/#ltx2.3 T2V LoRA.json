{
    "backup_after": 10,
    "base_model_name": "dg845/LTX-2.3-Diffusers",
    "batch_size": 1,
    "dataloader_threads": 1,
    "learning_rate": 0.0003,
    "model_type": "LTX_2_3",
    "output_model_destination": "models/lora.safetensors",
    "output_model_format": "COMFY_LORA",
    "resolution": "512",
    "timestep_distribution": "LOGIT_NORMAL",
    "dynamic_timestep_shifting": false,
    "train_dtype": "BFLOAT_16",
    "training_method": "LORA",
    "async_offloading": true,
    "async_gradient_reduce": true,
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_8",
        "gradient_checkpointing": true,
        "offload_fraction": 1.0,
        "activation_offloading": true
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "vae": {
        "train": false,
        "weight_dtype": "FLOAT_32"
    },
    "audio_vae": {
        "train": false,
        "weight_dtype": "FLOAT_32"
    },
    "layer_filter": ".attn1.,.attn2.,.ff.",
    "layer_filter_preset": "video",
    "ltx_distilled_lora_path": "Lightricks/LTX-2.3/ltx-2.3-22b-distilled-lora-384-1.1.safetensors",
    "ltx_spatial_upsampler_x1_5_path": "Lightricks/LTX-2.3/ltx-2.3-spatial-upscaler-x1.5-1.0.safetensors",
    "ltx_spatial_upsampler_x2_path": "Lightricks/LTX-2.3/ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
}
